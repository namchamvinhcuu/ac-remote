APP_USER=admin
# REQUIRED: at least 12 characters, e.g. `openssl rand -base64 24`. The app refuses to start otherwise.
APP_PASSWORD=
# Address the web UI binds to on the host: 127.0.0.1 (behind a TLS reverse proxy, or CLI-only access) or a VPN-only address.
BIND_ADDR=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
